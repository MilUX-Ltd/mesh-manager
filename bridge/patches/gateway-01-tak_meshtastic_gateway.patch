+def takv2_decode(payload, dictionaries, zstd="lazy"):
+    """A port-78 wire payload to (TAKPacketV2, None), or (None, reason). Never raises.
+    `zstd` is the zstandard module, imported lazily so a box without it still runs V1."""
+    try:
+        if not payload:
+            return None, "empty payload"
+        flags = payload[0]
+        body = bytes(payload[1:])
+        if flags == 0xFF:
+            raw = body
+        else:
+            dict_id = flags & 0x3F              # bits 6-7 are reserved: ignored on receive
+            d = (dictionaries or {}).get(dict_id)
+            if d is None:
+                return None, f"no dictionary for id {dict_id}"
+            if zstd == "lazy":
+                try:
+                    import zstandard as zstd
+                except ImportError:
+                    zstd = None
+            if zstd is None:
+                return None, "zstandard is not installed, cannot decompress TAK V2"
+            cached = _TAKV2_DCTX.get(dict_id)
+            if cached is None or cached[0] is not d:
+                cached = (d, zstd.ZstdDecompressor(dict_data=zstd.ZstdCompressionDict(d)))
+                _TAKV2_DCTX[dict_id] = cached
+            raw = cached[1].decompress(TAKV2_ZSTD_MAGIC + body, max_output_size=TAKV2_MAX_DECOMPRESSED)
+        pb = atak_pb2.TAKPacketV2()
+        pb.ParseFromString(raw)
+        if not (pb.callsign or pb.uid or pb.device_callsign or pb.latitude_i or pb.longitude_i
+                or pb.WhichOneof("payload_variant")):
+            return None, "decoded to an empty packet"
+        return pb, None
+    except BaseException as e:                  # a bad packet is dropped, never a crash
+        return None, f"{type(e).__name__}: {e}"
