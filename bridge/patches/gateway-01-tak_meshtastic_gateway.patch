+def takv2_dictionaries(search_dirs=None):
+    """The zstd dictionaries by id, read from the first directory that holds each one:
+    $VANTAGE_MESH_DICTS, then dicts/ beside this module. A dictionary that is nowhere is
+    simply absent from the result; the caller decides what to say about that."""
+    dirs = list(search_dirs) if search_dirs is not None else []
+    if search_dirs is None:
+        env = os.environ.get("VANTAGE_MESH_DICTS")
+        if env:
+            dirs.append(env)
+        dirs.append(os.path.join(os.path.dirname(os.path.abspath(__file__)), "dicts"))
+    found = {}
+    for d in dirs:
+        for dict_id, name in TAKV2_DICT_FILES.items():
+            path = os.path.join(d, name)
+            if dict_id not in found and os.path.isfile(path):
+                try:
+                    with open(path, "rb") as fh:
+                        found[dict_id] = fh.read()
+                except OSError:
+                    pass
+        if len(found) == len(TAKV2_DICT_FILES):
+            break
+    return found
