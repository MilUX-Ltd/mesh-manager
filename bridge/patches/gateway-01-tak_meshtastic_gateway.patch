+# patched 3 Sep 2026 (Spec 008): TAK V2, port 78 (ATAK_PLUGIN_V2). Firmware 2.8 radios and
+# the Meshtastic app's TAK server send TAKPacketV2 on this port in the TAKPacket-SDK wire
+# format (WIRE_FORMAT.md v1.2): one flags byte, then either a zstd frame body with its 4-byte
+# magic stripped (bits 0-5 of the flags name the dictionary: 0 non-aircraft, 1 aircraft) or,
+# when the flags byte is 0xFF, the raw protobuf. The dictionaries ship inside this package
+# (dicts/, pinned from the SDK), so every packet decodes from its own bytes alone. Nothing in
+# here may raise into the receive path: a packet the gateway cannot read is dropped with a
+# reason, and the V1 path for older radios is untouched.
+TAKV2_PORT = "ATAK_PLUGIN_V2"
+TAKV2_ZSTD_MAGIC = b"\x28\xb5\x2f\xfd"
+TAKV2_MAX_DECOMPRESSED = 4096
+TAKV2_DICT_FILES = {0: "dict_non_aircraft.zstd", 1: "dict_aircraft.zstd"}
+TAKV2_ROLES = {"TeamMember": "Team Member", "TeamLead": "Team Lead", "HQ": "HQ",
+               "Sniper": "Sniper", "Medic": "Medic", "ForwardObserver": "Forward Observer",
+               "RTO": "RTO", "K9": "K9"}
