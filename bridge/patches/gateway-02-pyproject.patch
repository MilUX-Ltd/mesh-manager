# MilUX patch, 3 Sep 2026 (Spec 008), applies to TAK-Meshtastic-Gateway 1.1.0 pyproject.toml: the gateway declares zstandard so an offline
# `pip install --no-index --find-links wheels TAK-Meshtastic-Gateway` pulls it from the
# bundle. Found by the offline rehearsal on the deployed box (LESSONS 24): the wheel was
# in the bundle and nothing installed it.
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -22,6 +22,7 @@
 unishox2-py3 = "1.0.0"
 netifaces2 = "0.0.22"
 takproto = "*"
+zstandard = "0.25.0"  # MilUX patch (Spec 008): TAK V2 decode needs zstd; pinned to the bundle wheel
 
 [tool.poetry-dynamic-versioning]
 enable = false
